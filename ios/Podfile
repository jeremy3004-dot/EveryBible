require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'EveryBible' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  # AppCheckCore ships as a Swift pod and is pulled in transitively by
  # @react-native-google-signin. CocoaPods refuses to integrate a Swift pod as a
  # static library unless its Objective-C dependencies generate module maps, so
  # a clean `pod install` fails with:
  #   [!] The following Swift pods cannot yet be integrated as static libraries
  # Opt just those two dependencies into modular headers instead of flipping
  # use_modular_headers! globally, which would change how every pod is built.
  # Podfile.lock is untracked, so every EAS archive resolves pods from scratch
  # and hits this; pinning it here keeps clean-checkout builds reproducible.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # Alternate app icons must be included when CocoaPods compiles xcassets for App Store uploads.
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*-resources.sh')).each do |resource_script|
      next unless File.exist?(resource_script)

      contents = File.read(resource_script)
      next if contents.include?('--include-all-app-icons')

      updated_contents = contents.gsub(
        '--app-icon "${ASSETCATALOG_COMPILER_APPICON_NAME}" --output-partial-info-plist',
        '--app-icon "${ASSETCATALOG_COMPILER_APPICON_NAME}" --include-all-app-icons --output-partial-info-plist'
      )

      next if updated_contents == contents

      File.write(resource_script, updated_contents)
    end

    # fmt 11.0.2 (pinned transitively by RCT-Folly) fails to compile under the
    # Clang shipped with Xcode 26, which correctly rejects fmt's own internal
    # FMT_STRING(...) calls inside consteval context:
    #   fmt/format-inl.h:59 error: call to consteval function
    #   'fmt::basic_format_string<...>' is not a constant expression
    # Upstream fixed this in fmt 11.1.0, but React Native pins `fmt (= 11.0.2)`
    # so we cannot bump it here. Disabling consteval downgrades those format
    # strings from compile-time to run-time checked, which is exactly the
    # behaviour fmt itself selects on any toolchain lacking consteval support.
    #
    # This has to patch the header rather than pass -DFMT_USE_CONSTEVAL=0:
    # base.h defines BOTH FMT_USE_CONSTEVAL and FMT_CONSTEVAL unconditionally
    # (no #ifndef guard), so any external -D for either one is overwritten.
    # Remove this once React Native ships a fmt >= 11.1.0.
    fmt_base_header = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_header)
      contents = File.read(fmt_base_header)
      patched = contents.gsub('#  define FMT_USE_CONSTEVAL 1', '#  define FMT_USE_CONSTEVAL 0')

      unless patched == contents
        # CocoaPods checks out pod sources read-only, so restore the mode after.
        original_mode = File.stat(fmt_base_header).mode
        File.chmod(0o644, fmt_base_header)
        File.write(fmt_base_header, patched)
        File.chmod(original_mode, fmt_base_header)
      end
    end
  end
end
