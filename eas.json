{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EL_MEDIA_BASE_URL": "https://lqd-media.platform-979.workers.dev",
        "EXPO_PUBLIC_EL_MEDIA_SOURCE": "true"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EL_MEDIA_BASE_URL": "https://lqd-media.platform-979.workers.dev",
        "EXPO_PUBLIC_EL_MEDIA_SOURCE": "true"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx4g",
        "EXPO_PUBLIC_EL_MEDIA_BASE_URL": "https://lqd-media.platform-979.workers.dev"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight-el": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_EL_MEDIA_SOURCE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "curryj@protonmail.com",
        "ascAppId": "6758254335",
        "appleTeamId": "NVC9N47PRH"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "ios": {
        "appleId": "curryj@protonmail.com",
        "ascAppId": "6758254335",
        "appleTeamId": "NVC9N47PRH"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
