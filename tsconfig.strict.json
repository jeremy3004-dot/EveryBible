{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/services/**/*",
    "src/stores/**/*",
    "src/utils/**/*",
    "src/hooks/**/*",
    "src/constants/**/*",
    "src/i18n/**/*",
    "src/design/**/*",
    "src/contexts/**/*",
    "src/data/**/*",
    "src/testing/**/*"
  ]
}
